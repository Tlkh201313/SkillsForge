{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsforge.local/schemas/agent.frontmatter.schema.json",
  "title": "Claude Code plugin agent frontmatter",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "minLength": 1
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1
    },
    "tools": {
      "$ref": "#/$defs/toolList"
    },
    "disallowedTools": {
      "$ref": "#/$defs/toolList"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "boolean"
    },
    "isolation": {
      "const": "worktree"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "toolList": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
