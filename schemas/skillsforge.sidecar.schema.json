{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsforge.local/schemas/skillsforge.sidecar.schema.json",
  "title": "SkillsForge capability sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routing", "capabilities"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "maturity": {
      "type": "string",
      "enum": ["experimental", "stable", "deprecated"]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "antiTriggers"],
      "properties": {
        "triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "antiTriggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exec", "network", "write"],
      "properties": {
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "commands"],
          "properties": {
            "allowed": { "type": "boolean" },
            "commands": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "hosts"],
          "properties": {
            "allowed": { "type": "boolean" },
            "searchAllowed": { "type": "boolean" },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9.-]+(?::\\d+)?$"
              },
              "uniqueItems": true
            }
          }
        },
        "write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "type": "string",
              "enum": ["skill", "project", "none"]
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "boolean" },
            "tools": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["full", "partial", "unsupported"]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  }
}
