{
  "name": "skillsforge",
  "version": "0.4.1",
  "description": "Work OS for productive Agent Skills: route, workflows, library, multi-host install — with validate/package/receipts as the safety layer.",
  "type": "module",
  "bin": {
    "skillsforge": "./plugins/skillsforge/bin/skillsforge.mjs",
    "skillsforge-validate": "./plugins/skillsforge/bin/skillsforge-validate"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node plugins/skillsforge/bin/skillsforge.mjs validate --profile claude-code --all",
    "validate:repo": "node scripts/validate-repo.mjs",
    "validate:plugin": "claude plugin validate . --strict",
    "validate:host": "node scripts/host-validation.mjs --require-dist --out artifacts/host-validation.json",
    "test": "node scripts/test.mjs",
    "eval": "node scripts/eval.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:judge": "node plugins/skillsforge/bin/skillsforge.mjs demo",
    "mcp": "node scripts/skillsforge-mcp.mjs",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "gen:schemas:check": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "build:dist": "node scripts/build-dist.mjs",
    "smoke:dist": "node --test tests/dist-smoke.test.mjs",
    "evidence": "node scripts/evidence.mjs",
    "gen:packs": "node scripts/gen-pack-skills.mjs",
    "vibe": "node plugins/skillsforge/bin/skillsforge.mjs vibe",
    "quality": "node plugins/skillsforge/bin/skillsforge.mjs quality",
    "bench": "node plugins/skillsforge/bin/skillsforge.mjs bench",
    "check": "npm run validate:repo && npm run validate && npm test && npm run eval && npm run demo && npm run build:check && npm run build && npm run build:dist && npm run smoke:dist && npm run validate:host && npm run evidence -- --out artifacts/evidence"
  },
  "files": [
    "README.md",
    "LICENSE",
    "VERSION",
    "catalog/",
    "plugins/skillsforge/",
    "schemas/",
    "lib/",
    "scripts/",
    "examples/",
    "assets/*.svg",
    "assets/skillsforge-demo-poster.png",
    "assets/video/skillsforge-demo.mp4"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.207",
    "esbuild": "^0.28.1"
  }
}
