{
  "schemaVersion": 1,
  "maturity": "stable",
  "requires": [
    "using-skillsforge"
  ],
  "routing": {
    "triggers": [
      "update skill library",
      "refresh skillsforge library",
      "rebuild ai skill index",
      "installed new skills",
      "skills changed",
      "refresh local skills html"
    ],
    "antiTriggers": [
      "install a new skill",
      "remove a skill",
      "write a new skill from scratch",
      "edit README only"
    ],
    "mode": "auto",
    "pack": "browse-catalog"
  },
  "capabilities": {
    "exec": {
      "allowed": true,
      "commands": [
        "skillsforge init",
        "node plugins/skillsforge/bin/skillsforge.mjs init",
        "skillsforge lib update",
        "node plugins/skillsforge/bin/skillsforge.mjs lib update",
        "skillsforge lib select",
        "skillsforge lib unselect",
        "skillsforge lib selected",
        "skillsforge lib open",
        "skillsforge session remember",
        "skillsforge session summary",
        "skillsforge session score"
      ]
    },
    "network": {
      "allowed": false,
      "hosts": []
    },
    "write": {
      "scope": "project"
    }
  },
  "compatibility": {
    "claude-code": "full",
    "cursor": "partial",
    "codex": "full"
  },
  "provenance": {
    "source": "original",
    "license": "MIT"
  }
}
