{
  "schemaVersion": 1,
  "maturity": "stable",
  "requires": ["using-skillsforge"],
  "routing": {
    "triggers": ["create a skill", "write a new skill", "edit skill frontmatter", "add a sidecar", "forge a capability"],
    "antiTriggers": ["run the tests", "security audit of skills"]
  },
  "capabilities": {
    "exec": {
      "allowed": true,
      "commands": [
        "skillsforge forge",
        "skillsforge validate",
        "node plugins/skillsforge/bin/skillsforge.mjs forge",
        "node plugins/skillsforge/bin/skillsforge.mjs validate"
      ]
    },
    "network": { "allowed": false, "hosts": [] },
    "write": { "scope": "project" }
  },
  "compatibility": {
    "claude-code": "full",
    "cursor": "partial"
  },
  "provenance": {
    "source": "original",
    "license": "MIT"
  }
}
