{
  "schemaVersion": 1,
  "maturity": "stable",
  "requires": ["using-skillsforge"],
  "routing": {
    "triggers": [
      "create a skill",
      "write a new skill",
      "edit skill frontmatter",
      "add a sidecar",
      "into a sidecar",
      "add routing triggers",
      "forge a capability",
      "forge from a spec",
      "write sidecar",
      "sidecar metadata"
    ],
    "antiTriggers": [
      "run the tests",
      "security audit of skills",
      "forge steel",
      "capability bracket"
    ]
  },
  "capabilities": {
    "exec": {
      "allowed": true,
      "commands": [
        "skillsforge forge",
        "skillsforge validate",
        "node plugins/skillsforge/bin/skillsforge.mjs forge",
        "node plugins/skillsforge/bin/skillsforge.mjs validate"
      ]
    },
    "network": { "allowed": false, "hosts": [] },
    "write": { "scope": "project" }
  },
  "compatibility": {
    "claude-code": "full",
    "cursor": "partial"
  },
  "provenance": {
    "source": "original",
    "license": "MIT"
  }
}
