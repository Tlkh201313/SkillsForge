{
  "name": "policy-adversarial",
  "frozen": "2026-07-18",
  "cases": [
    {
      "id": "allow-declared-bash",
      "expected": "allow",
      "event": {
        "tool_name": "Bash",
        "tool_input": { "command": "node scripts/ok.mjs" }
      },
      "policy": {
        "schemaVersion": 1,
        "capabilities": {
          "exec": { "allowed": true, "commands": ["node scripts/ok.mjs"] },
          "network": { "allowed": false, "hosts": [] },
          "write": { "scope": "skill" },
          "mcp": { "allowed": false, "tools": [] }
        },
        "__skillRoot": "/tmp/sf-policy-skill",
        "__projectRoot": "/tmp/sf-policy-project"
      }
    },
    {
      "id": "deny-bash-chaining",
      "expected": "deny",
